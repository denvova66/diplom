<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="24dp">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выберите марку"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp" />

    <!-- Поиск -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/search_bg"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:alpha="0.4"
            android:layout_marginEnd="10dp" />

        <EditText
            android:id="@+id/searchBrandEditText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Поиск марки"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textColorHint="#AAAAAA" />
    </LinearLayout>

    <!-- Популярные бренды -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Популярные"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/popularBrandsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flexWrap="wrap"
        app:flexDirection="row"
        app:alignItems="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="8dp" />

    <!-- Разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Полный список -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Все марки"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/allBrandsRecycler"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <!-- Кнопка сброса -->
    <TextView
        android:id="@+id/resetBrandButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Сбросить"
        android:textSize="15sp"
        android:textColor="#E53935"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/reset_btn_bg"
        android:foreground="?attr/selectableItemBackground" />

</LinearLayout>