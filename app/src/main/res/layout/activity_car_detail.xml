<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Детали авто"
        app:titleTextColor="@color/black" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Галерея изображений - большое фото -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/carImagesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/brandModelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BMW X5"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 500 000 ₽"
                    android:textSize="22sp"
                    android:textColor="@color/red"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/yearText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Год: 2020"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/mileageText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Пробег: 45 000 км"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/engineText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Объем: 3.0 л"
                            android:textSize="16sp"
                            android:textColor="@color/black" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Описание"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/descriptionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Отличное состояние"
                            android:textSize="15sp"
                            android:textColor="#666666" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/editButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Редактировать"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/chatButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Написать продавцу"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/contactButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Позвонить"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/reviewsButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Отзывы о продавце"
                    android:textColor="@color/red"
                    android:backgroundTint="@color/white"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/favoriteButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="В избранное"
                    android:textColor="@color/red"
                    android:backgroundTint="@color/white"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/reportButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Пожаловаться на объявление"
                    android:textColor="#FF9800"
                    android:backgroundTint="@color/white"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/deleteButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Удалить"
                    android:textColor="@color/white"
                    android:backgroundTint="#FF4444"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>