<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/swag_green_dark" />
            <corners android:radius="25dp" />
            <stroke
                android:width="2dp"
                android:color="@color/swag_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/swag_green" />
            <corners android:radius="25dp" />
            <stroke
                android:width="2dp"
                android:color="@color/swag_green_dark" />
        </shape>
    </item>
</selector>